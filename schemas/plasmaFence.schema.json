{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORE-CRUSH プラズマ・フェンス（GDD 13。プランナー 2026-10-01: ノイズの放電は入れない。定期的に薄く色づく波紋＋うっすら歪むだけ）",
  "type": "object",
  "additionalProperties": false,
  "required": ["heightM", "tintColor", "baseHdr", "topFadeM", "pulse", "distortion", "ripple"],
  "definitions": {
    "faint": { "description": "フェンスの色づき: 球が見えなくならないよう弱く（0.3 未満）", "type": "number", "minimum": 0, "maximum": 0.3 }
  },
  "properties": {
    "heightM": { "type": "number", "exclusiveMinimum": 0 },
    "tintColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "baseHdr": { "$ref": "#/definitions/faint" },
    "topFadeM": { "type": "number", "minimum": 0 },
    "pulse": {
      "description": "定期的に中央から広がる薄い色の波紋",
      "type": "object", "additionalProperties": false, "required": ["periodSec", "speedMps", "widthM", "hdr"],
      "properties": { "periodSec": { "type": "number", "exclusiveMinimum": 0 }, "speedMps": { "type": "number", "exclusiveMinimum": 0 }, "widthM": { "type": "number", "exclusiveMinimum": 0 }, "hdr": { "$ref": "#/definitions/faint" } }
    },
    "distortion": {
      "description": "向こう側の景色をうっすら歪める（滑らかな波。画面の UV に対する量）",
      "type": "object", "additionalProperties": false, "required": ["amount", "waveM", "speed"],
      "properties": { "amount": { "type": "number", "minimum": 0, "maximum": 0.01 }, "waveM": { "type": "number", "exclusiveMinimum": 0 }, "speed": { "type": "number", "minimum": 0 } }
    },
    "ripple": {
      "description": "球の通過・人が触れたときの波紋（uniform 4 つを使い回す。vfx 規則）",
      "type": "object", "additionalProperties": false,
      "required": ["max", "speedMps", "widthM", "lifeSec", "crossHdr", "touchHdr", "touchCooldownSec"],
      "properties": {
        "max": { "const": 4 },
        "speedMps": { "type": "number", "exclusiveMinimum": 0 },
        "widthM": { "type": "number", "exclusiveMinimum": 0 },
        "lifeSec": { "type": "number", "exclusiveMinimum": 0 },
        "crossHdr": { "$ref": "#/definitions/faint" },
        "touchHdr": { "$ref": "#/definitions/faint" },
        "touchCooldownSec": { "type": "number", "minimum": 0 }
      }
    }
  }
}
