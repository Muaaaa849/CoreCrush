{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CORE-CRUSH 画づくり（GDD 12.2）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "toneMappingExposure",
    "bloom",
    "post",
    "stage"
  ],
  "properties": {
    "toneMappingExposure": {
      "description": "ACES Filmic の露出（GDD 12.2: 0.9 前後）",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bloom": {
      "description": "トーンマップ前の HDR 色に掛けるブルーム（BloomNode）。しきい値を超えるのは emissive を強くした物だけにする（ADR 0005）",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "radius",
        "threshold"
      ],
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threshold": {
          "description": "HDR 色の輝度がこれ未満は光らない。照明を受けた普通の面は 1 未満に収める",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vignette",
        "edgeBlur",
        "chromaticAberration",
        "grain",
        "lensFlare",
        "lightLeak",
        "grade",
        "dust",
        "ao"
      ],
      "properties": {
        "vignette": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "radius",
            "softness"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "端の暗さ（0=なし）"
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "description": "暗くなり始める半径（縦の半分=1）"
            },
            "softness": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "edgeBlur": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startR",
            "maxPx"
          ],
          "properties": {
            "startR": {
              "type": "number",
              "minimum": 0,
              "description": "ぼけ始める半径（中心=照準は触らない）"
            },
            "maxPx": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            }
          },
          "description": "画面端のぼけ（高画質のみ。quality.edgeBlur）"
        },
        "chromaticAberration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startR",
            "amountPx"
          ],
          "properties": {
            "startR": {
              "type": "number",
              "minimum": 0
            },
            "amountPx": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            }
          },
          "description": "画面端だけの色収差（edgeBlur と同じパス）"
        },
        "grain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "shadowPow"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "shadowPow": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "フィルムグレイン。暗部ほど強い（quality.filmFx）"
        },
        "lensFlare": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threshold",
            "ghostSamples",
            "ghostSpacing",
            "ghostAttenuation",
            "blurSigma",
            "strength",
            "tint"
          ],
          "properties": {
            "threshold": {
              "type": "number",
              "minimum": 0
            },
            "ghostSamples": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "ghostSpacing": {
              "type": "number",
              "minimum": 0
            },
            "ghostAttenuation": {
              "type": "number",
              "minimum": 0
            },
            "blurSigma": {
              "type": "number",
              "minimum": 0
            },
            "strength": {
              "type": "number",
              "minimum": 0
            },
            "tint": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "description": "ブルームから作るゴースト（quality.lensFlare）"
        },
        "lightLeak": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "amount",
            "sizeR",
            "speed"
          ],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "sizeR": {
              "type": "number",
              "minimum": 0
            },
            "speed": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "画面左上から差し込む暖色の光（quality.filmFx）"
        },
        "grade": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slope",
            "offset",
            "power",
            "saturation",
            "contrast",
            "shadowTint",
            "highlightTint",
            "splitAmount",
            "halation"
          ],
          "properties": {
            "slope": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "offset": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "power": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "saturation": {
              "type": "number",
              "minimum": 0
            },
            "contrast": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "S 字カーブの混ぜ量"
            },
            "shadowTint": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "highlightTint": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "splitAmount": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "halation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color",
                "amount"
              ],
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "description": "ブルームを暖色に寄せる量"
            }
          },
          "description": "表示色（トーンマップ後）のカーブ。ASC CDL＋スプリットトーン"
        },
        "dust": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "sizePx",
            "hdr",
            "color",
            "areaM",
            "driftMps"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000
            },
            "sizePx": {
              "type": "number",
              "minimum": 0
            },
            "hdr": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.95,
              "description": "ブルームのしきい値未満（光らせない）"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "areaM": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "driftMps": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "空気中の塵（うっすら。数は quality.particleMul を掛ける）"
        },
        "ao": {
          "description": "環境遮蔽（GTAO。高画質のみ quality.ao）",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius",
            "thickness",
            "samples",
            "intensity",
            "resolutionScale"
          ],
          "properties": {
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "thickness": {
              "type": "number",
              "minimum": 0
            },
            "samples": {
              "type": "integer",
              "minimum": 4,
              "maximum": 32
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "resolutionScale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "description": "シネマティックなコンポジット（docs/research/graphics-compositing.md）"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "fog",
        "hemi",
        "sun",
        "areaLights",
        "env",
        "floor",
        "lines",
        "cage",
        "opponentRim",
        "crowd",
        "backdrop",
        "props",
        "fire",
        "fighter",
        "skyline",
        "floods",
        "truss",
        "charFill",
        "markers",
        "beacon",
        "ribbon"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "fog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "nearM",
            "farM",
            "groundHeightM",
            "groundDensity"
          ],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "nearM": {
              "type": "number",
              "minimum": 0
            },
            "farM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "groundHeightM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "groundDensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "description": "距離の霧＋コートの外の地面に溜まる霧"
        },
        "hemi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sky",
            "ground",
            "intensity"
          ],
          "properties": {
            "sky": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "ground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "intensity": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "sun": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "intensity",
            "posM"
          ],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "intensity": {
              "type": "number",
              "minimum": 0
            },
            "posM": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "description": "影を落とす主光源（1 灯だけ）"
        },
        "areaLights": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "color",
              "intensity",
              "widthM",
              "heightM",
              "posM",
              "lookAtM"
            ],
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "intensity": {
                "type": "number",
                "minimum": 0
              },
              "widthM": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "heightM": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "posM": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "lookAtM": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intensity",
            "panelHdr"
          ],
          "properties": {
            "intensity": {
              "type": "number",
              "minimum": 0
            },
            "panelHdr": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "床に映すネオンの環境マップ"
        },
        "floor": {
          "description": "床（CC0 アスファルト＋水たまり＋平面反射）",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tileM",
            "albedoMul",
            "tint",
            "roughnessMul",
            "roughnessMin",
            "metalness",
            "normalScale",
            "puddleScale",
            "puddleCoverage",
            "puddleSoftness",
            "puddleDarken",
            "grimeScale",
            "grimeAmount",
            "reflectPuddle",
            "reflectDry",
            "reflectDistortion",
            "paint",
            "macroScale"
          ],
          "properties": {
            "tileM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "albedoMul": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "tint": {
              "$ref": "#/definitions/hex"
            },
            "roughnessMul": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "roughnessMin": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "metalness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "normalScale": {
              "type": "number",
              "minimum": 0
            },
            "puddleScale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "puddleCoverage": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "puddleSoftness": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "puddleDarken": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "grimeScale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "grimeAmount": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reflectPuddle": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reflectDry": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reflectDistortion": {
              "type": "number",
              "minimum": 0
            },
            "paint": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color",
                "widthM",
                "insetM",
                "circleM",
                "zoneCircleM",
                "wear",
                "albedo"
              ],
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "widthM": {
                  "type": "number",
                  "minimum": 0
                },
                "insetM": {
                  "type": "number",
                  "minimum": 0
                },
                "circleM": {
                  "type": "number",
                  "minimum": 0
                },
                "zoneCircleM": {
                  "type": "number",
                  "minimum": 0
                },
                "wear": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "albedo": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "macroScale": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "lines": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "widthM",
            "hdr"
          ],
          "properties": {
            "widthM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "hdr": {
              "type": "number",
              "minimum": 0,
              "description": "床のネオンライン。1 以上で光る。コア（3.0）より明るくしない"
            }
          }
        },
        "cage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "heightM",
            "cellM",
            "wireFrac",
            "opacity",
            "marginM",
            "postColor",
            "postSpacingM",
            "railsYM"
          ],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "heightM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cellM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "wireFrac": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "marginM": {
              "type": "number",
              "minimum": 0
            },
            "postColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "postSpacingM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "railsYM": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "maxItems": 6,
              "description": "横の手すりの高さ（m）"
            }
          }
        },
        "opponentRim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hdr",
            "power",
            "lightIntensity",
            "lightRangeM",
            "lightUpM"
          ],
          "properties": {
            "hdr": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1,
              "description": "光らせない物: ブルームのしきい値（1.0）未満"
            },
            "power": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lightIntensity": {
              "type": "number",
              "minimum": 0,
              "description": "相手の頭上のチーム色の点光源（足元に光だまり。遠くでも位置が読める）"
            },
            "lightRangeM": {
              "type": "number",
              "minimum": 0
            },
            "lightUpM": {
              "type": "number"
            }
          },
          "description": "相手のリムライト"
        },
        "crowd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "color",
            "rowsM",
            "heightM"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "rowsM": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 1
            },
            "heightM": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "backdrop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "haze",
            "saturation",
            "sky",
            "layers"
          ],
          "properties": {
            "haze": {
              "$ref": "#/definitions/hex"
            },
            "saturation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sky": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "texture",
                "radiusM",
                "horizonDeg",
                "bandDeg",
                "horizonColor",
                "zenithColor",
                "repeat",
                "hdr"
              ],
              "properties": {
                "texture": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$",
                  "description": "art/assets.json の id"
                },
                "radiusM": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "repeat": {
                  "type": "integer",
                  "minimum": 1
                },
                "hdr": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1,
                  "description": "背景は光らせない（ブルームのしきい値未満）"
                },
                "horizonDeg": {
                  "type": "number",
                  "description": "雲の絵の下端（地平線からの仰角・度）"
                },
                "bandDeg": {
                  "type": "number",
                  "description": "雲の絵の上端（これより上は天頂の色へ）"
                },
                "horizonColor": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "zenithColor": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            },
            "layers": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "texture",
                  "radiusM",
                  "count",
                  "widthM",
                  "yM",
                  "startDeg",
                  "hdr",
                  "haze"
                ],
                "properties": {
                  "texture": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$",
                    "description": "art/assets.json の id"
                  },
                  "radiusM": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "widthM": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "yM": {
                    "type": "number"
                  },
                  "startDeg": {
                    "type": "number"
                  },
                  "hdr": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 1,
                    "description": "背景は光らせない（ブルームのしきい値未満）"
                  },
                  "haze": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
